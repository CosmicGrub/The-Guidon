# Line endings are load-bearing in this project, not cosmetic.
#
# The build (guidon-app/tools/build.mjs) locates its edit points with exact
# string anchors against src/index.html, and a stray CRLF conversion has
# already broken it once: a Python write without newline='' rewrote the whole
# 5 MB file to CRLF and the document-terminator anchor stopped matching
# (masterfile §46). Checkout conversion would do the same thing to every fresh
# clone. So: source files are LF, everywhere, regardless of platform.

* text=auto

# App source and tooling: LF always
*.html   text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.webmanifest text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
gradlew  text eol=lf

# Windows-native scripts keep CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Binary — never converted
*.png    binary
*.ico    binary
*.icns   binary
*.jar    binary
*.pdf    binary
