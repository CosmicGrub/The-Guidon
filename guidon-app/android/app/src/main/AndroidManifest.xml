<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Enhancement backlog round 1, "Android allowBackup contradicts the
         Privacy Policy" bucket: the app's own #/privacy screen states flatly
         "no cloud sync" / "no network connection of any kind" and separately
         promises the squad roster - other people's data - is never bundled
         into a backup without a separate, explicit opt-in. allowBackup=true
         (the AGP default) with no exclusion rules let Android's OS-level
         Auto Backup silently copy this WebView's entire private storage -
         IndexedDB included, where the roster/profile/every record live -
         into the Soldier's Google Account cloud backup on the OS's own
         schedule, with none of GUIDON's own opt-in gating. Disabled
         outright rather than authoring a dataExtractionRules exclusion,
         since "nothing leaves this device" is this app's whole stated
         design goal and there is no legitimate use case here for OS-level
         cloud backup of app data. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Board Drill grading (index.html) and Quiz answer feedback call
         navigator.vibrate() for haptic feedback. `if (navigator.vibrate)` is
         truthy even without this permission — WebView silently swallows the
         resulting SecurityException, so every haptic buzz was a no-op on the
         shipped APK without it (task #204). -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
