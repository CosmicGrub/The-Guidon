node_modules/
dist/
web/
android/build/
android/app/build/
android/.gradle/
android/local.properties
src-tauri/target/
# Signing material must never be committed.
keys/
android/keystore.properties

# Scratch tooling: underscore-prefixed tools/_* files (both throwaway .mjs
# probes/debug helpers and the .json data/report files they emit) should
# never accumulate uncommitted in the tree. (The contrast-full-sweep-raw.json
# report this suite regenerates lives at the repo root under "GUIDON files/",
# not here -- ignored in the root .gitignore.)
tools/_*

# Reference Library: docs-source/_text/*.txt is a build artifact, fully
# regenerated from docs-source/*.pdf by `node tools/build-library-data.mjs`
# (which itself invokes pdftotext -enc UTF-8 fresh each run - see that
# script's header comment). The *.pdf files themselves ARE committed: they
# are the actual source of truth this feature is built on, and a fresh
# clone should get the complete feature, not one silently missing its
# "Original PDF" tab because nobody re-ran the fetch pipeline.
docs-source/_text/

# Verification output (WebKit shots, Simulator evidence). Regenerated per run.
artifacts/
# iOS build output and per-user Xcode state. The ios/ project itself IS
# committed - Info.plist, icons and the launch screen must survive CI reruns
# (see .github/workflows/ios.yml) - but nothing generated belongs in git.
ios/App/build/
ios/App/Pods/
ios/App/DerivedData/
# cap sync copies web/ here on every run; web/ is already ignored above.
ios/App/App/public/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
