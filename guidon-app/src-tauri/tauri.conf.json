{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GUIDON",
  "version": "1.4.22",
  "identifier": "app.guidon.trainer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "GUIDON — Army Leader Development Trainer",
        "width": 1280,
        "height": 880,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0e12",
        "decorations": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GUIDON",
    "copyright": "GUIDON",
    "category": "Education",
    "shortDescription": "Army leader development trainer",
    "longDescription": "Offline Army leader-development trainer for E1-E9: doctrine, board prep, the full NCOPDS ladder (BLC through SMC), promotion points, counseling forms and a spaced-repetition study drill. Works with no network connection.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
